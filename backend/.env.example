# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:비밀번호@localhost:5432/flatroad

# Firebase Admin SDK (서비스 계정 JSON 파일 경로)
FIREBASE_CREDENTIALS_PATH=./firebase-adminsdk.json

# Firebase Storage 버킷
FIREBASE_STORAGE_BUCKET=map2026-233a5.firebasestorage.app

# Detectron2 RetinaNet R-50-FPN 3x (AIHub 인도 보행 데이터셋, 13 classes)
# 모델 파일: retinanet_r_50_fpn_3x_aihub_final.pth 을 프로젝트 루트에 위치
DETECTRON2_WEIGHTS=../retinanet_r_50_fpn_3x_aihub_final.pth
DETECTRON2_SCORE_THRESH=0.5

# 서버
PORT=8000
